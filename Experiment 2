-- DBMS EXPERIMENT 2
-- E-commerce ER Diagram to Relational Schema
-- MySQL source code
-- Run this script in MySQL Workbench or the MySQL command line.

CREATE DATABASE IF NOT EXISTS ECOMMERCE_ER;
USE ECOMMERCE_ER;

-- Optional: uncomment these lines if you want to rebuild the database from scratch.
-- SET FOREIGN_KEY_CHECKS = 0;
-- DROP TABLE IF EXISTS DELIVERY, PAYMENT, ORDERITEM, ORDERS, GROCERY,
--     CLOTHING, ELECTRONICS, PRODUCT_SELLER, PRODUCT, CATEGORY,
--     SELLER, ADDRESS, CUSTOMER_PHONE, CUSTOMER;
-- SET FOREIGN_KEY_CHECKS = 1;

-- 1. CUSTOMER
CREATE TABLE CUSTOMER (
    CustomerID INT PRIMARY KEY,
    First_Name VARCHAR(30) NOT NULL,
    Last_Name VARCHAR(30) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Date_of_Birth DATE NOT NULL
) ENGINE = InnoDB;

-- 2. CUSTOMER_PHONE: one customer can have multiple phone numbers
CREATE TABLE CUSTOMER_PHONE (
    CustomerID INT NOT NULL,
    Phone VARCHAR(15) NOT NULL,
    PRIMARY KEY (CustomerID, Phone),
    FOREIGN KEY (CustomerID) REFERENCES CUSTOMER(CustomerID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 3. ADDRESS
CREATE TABLE ADDRESS (
    AddressID INT PRIMARY KEY,
    House_No VARCHAR(10),
    Street VARCHAR(50),
    City VARCHAR(30) NOT NULL,
    State VARCHAR(50) NOT NULL,
    PIN_Code VARCHAR(10) NOT NULL,
    Address_Type VARCHAR(20),
    CustomerID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES CUSTOMER(CustomerID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 4. SELLER
CREATE TABLE SELLER (
    SellerID INT PRIMARY KEY,
    Seller_Name VARCHAR(50) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Phone VARCHAR(15),
    GSTIN VARCHAR(20) NOT NULL UNIQUE
) ENGINE = InnoDB;

-- 5. CATEGORY
CREATE TABLE CATEGORY (
    CategoryID INT PRIMARY KEY,
    Category_Name VARCHAR(50) NOT NULL UNIQUE,
    Description VARCHAR(150)
) ENGINE = InnoDB;

-- 6. PRODUCT
-- CategoryID is nullable so ON DELETE SET NULL can be demonstrated.
CREATE TABLE PRODUCT (
    ProductID INT PRIMARY KEY,
    Product_Name VARCHAR(100) NOT NULL,
    Price DECIMAL(10,2) NOT NULL,
    Description VARCHAR(200),
    Stock_Quantity INT NOT NULL DEFAULT 0,
    Brand VARCHAR(50),
    CategoryID INT NULL,
    FOREIGN KEY (CategoryID) REFERENCES CATEGORY(CategoryID)
        ON DELETE SET NULL
) ENGINE = InnoDB;

-- 7. PRODUCT_SELLER: many-to-many relationship between products and sellers
CREATE TABLE PRODUCT_SELLER (
    ProductID INT NOT NULL,
    SellerID INT NOT NULL,
    PRIMARY KEY (ProductID, SellerID),
    FOREIGN KEY (ProductID) REFERENCES PRODUCT(ProductID)
        ON DELETE CASCADE,
    FOREIGN KEY (SellerID) REFERENCES SELLER(SellerID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 8. ELECTRONICS: subtype of PRODUCT
CREATE TABLE ELECTRONICS (
    ProductID INT PRIMARY KEY,
    Warranty_Period VARCHAR(30),
    Model_Number VARCHAR(50),
    FOREIGN KEY (ProductID) REFERENCES PRODUCT(ProductID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 9. CLOTHING: subtype of PRODUCT
CREATE TABLE CLOTHING (
    ProductID INT PRIMARY KEY,
    Size VARCHAR(10),
    Colour VARCHAR(30),
    Material VARCHAR(30),
    FOREIGN KEY (ProductID) REFERENCES PRODUCT(ProductID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 10. GROCERY: subtype of PRODUCT
CREATE TABLE GROCERY (
    ProductID INT PRIMARY KEY,
    Expiry_Date DATE,
    Weight DECIMAL(8,2),
    FOREIGN KEY (ProductID) REFERENCES PRODUCT(ProductID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 11. ORDERS
CREATE TABLE ORDERS (
    OrderID INT PRIMARY KEY,
    Order_Date DATE NOT NULL,
    Order_Status VARCHAR(20) NOT NULL,
    Total_Amount DECIMAL(10,2) NOT NULL,
    CustomerID INT NOT NULL,
    FOREIGN KEY (CustomerID) REFERENCES CUSTOMER(CustomerID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 12. ORDERITEM
CREATE TABLE ORDERITEM (
    OrderID INT NOT NULL,
    ProductID INT NOT NULL,
    Quantity INT NOT NULL,
    Unit_Price DECIMAL(10,2) NOT NULL,
    Subtotal DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (OrderID, ProductID),
    FOREIGN KEY (OrderID) REFERENCES ORDERS(OrderID)
        ON DELETE CASCADE,
    FOREIGN KEY (ProductID) REFERENCES PRODUCT(ProductID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 13. PAYMENT
CREATE TABLE PAYMENT (
    PaymentID INT PRIMARY KEY,
    Payment_Date DATE NOT NULL,
    Amount DECIMAL(10,2) NOT NULL,
    Payment_Method VARCHAR(30) NOT NULL,
    Payment_Status VARCHAR(20) NOT NULL,
    TransactionID VARCHAR(30) UNIQUE,
    OrderID INT NOT NULL UNIQUE,
    FOREIGN KEY (OrderID) REFERENCES ORDERS(OrderID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

-- 14. DELIVERY
CREATE TABLE DELIVERY (
    DeliveryID INT PRIMARY KEY,
    Delivery_Date DATE NULL,
    Delivery_Status VARCHAR(20) NOT NULL,
    Tracking_ID VARCHAR(30) UNIQUE,
    Delivery_Partner VARCHAR(50),
    OrderID INT NOT NULL UNIQUE,
    FOREIGN KEY (OrderID) REFERENCES ORDERS(OrderID)
        ON DELETE CASCADE
) ENGINE = InnoDB;

