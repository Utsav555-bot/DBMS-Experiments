-- OUTPUT 3: demonstrate a referential integrity violation.
-- This INSERT should fail because CustomerID 999 does not exist in CUSTOMER.
-- Run separately if your SQL client stops executing after an error.
INSERT INTO ORDERS
    (OrderID, Order_Date, Order_Status, Total_Amount, CustomerID)
VALUES
    (502, '2026-08-14', 'Placed', 50000.00, 999);

-- OUTPUT 4: demonstrate ON DELETE SET NULL.
-- Product 301 remains, but its CategoryID becomes NULL.
DELETE FROM CATEGORY WHERE CategoryID = 201;
SELECT ProductID, Product_Name, CategoryID
FROM PRODUCT
WHERE ProductID = 301;

-- OUTPUT 5: demonstrate ON DELETE CASCADE.
-- This deletes the customer's orders, order items, payment, delivery,
-- address and phone rows through the foreign-key cascade rules.
DELETE FROM CUSTOMER WHERE CustomerID = 1;

-- OUTPUT 6: verify that the dependent rows have been removed.
SELECT 'ORDERS' AS Table_Name, COUNT(*) AS Row_Count_After_Delete FROM ORDERS
UNION ALL
SELECT 'ORDERITEM', COUNT(*) FROM ORDERITEM
UNION ALL
SELECT 'PAYMENT', COUNT(*) FROM PAYMENT
UNION ALL
SELECT 'DELIVERY', COUNT(*) FROM DELIVERY
UNION ALL
SELECT 'ADDRESS', COUNT(*) FROM ADDRESS
UNION ALL
SELECT 'CUSTOMER_PHONE', COUNT(*) FROM CUSTOMER_PHONE;
